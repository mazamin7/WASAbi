{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build and Run",
            "type": "process",
            "command": "C:/msys64/usr/bin/bash.exe",
            "options": {
                "env": {
                    "MSYSTEM": "MINGW64",
                    "CHERE_INVOKING": "1",
                    "PATH": "/mingw64/bin:/usr/local/bin:/usr/bin:/bin:${env:PATH}"
                }
            },
            "args": [
                "-l",
                "-c",
                // This is the complete, robust command chain:
                // 1. Go to project root (with path conversion)
                // 2. Build the project
                // 3. CRUCIAL: Change CWD to source/build
                // 4. Run the executable from the correct location
                "cd \"$(cygpath -u '${workspaceFolder}')\" && ./build_windows.sh && cd source/build && ./WASAbiApp.exe"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [],
            "detail": "Builds and immediately runs the application"
        }
    ]
}